        df["revenue_per_comment"]        = df[config["COL_REVENUE"]] / df[config["COL_COMMENTS"]].replace(0, 1)
        df["cost_efficiency_tier"]       = pd.cut(df["cost_per_discount_use"], bins=[0,25,50,100,float("inf")], labels=["Elite","Good","Fair","Poor"])
