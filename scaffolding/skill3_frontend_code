[\n    CONFIG[\"REPORTS_DIR\"],\n    CONFIG[\"MODELS_DIR\"],\n    \"data/raw\",\n    \"data/processed\",\n    \"reports/frontend\",\n]:\n    os.makedirs(_dir, exist_ok=True)\n\nprint(\"Phase 0 complete - directories initialised.\")\n"))

