cells.append(_code_cell("# -- Phase 12: Write generate_report.py --\nimport textwrap as _tw\n\n_report_code = _tw.dedent('''\n    import pandas as pd\n\n    def generate_report():\n        from config.config import CONFIG\n        df = pd.read_csv(CONFIG[\"FEAT_CSV\"])\n        lines = [\n            \"SLIDE 01 - INFLUENCER MARKETING ROI INTELLIGENCE REPORT\",\n            \"Total Campaigns: \" + str(len(df)),\n            \"\",\n            \"SLIDE 02 - THE BUSINESS PROBLEM\",\n            \"Brands invest budgets without systematic ROI prediction.\",\n            \"\",\n            \"SLIDE 03 - CAMPAIGN PORTFOLIO OVERVIEW\",\n            \"Platforms : \" + str(list(df[\"platform_clean\"].unique())),\n            \"Niches    : \" + str(list(df[CONFIG[\"COL_NICHE\"]].astype(str).unique())),\n            \"\",\n            \"SLIDE 04 - ROI PERFORMANCE BASELINE\",\n            \"High-ROI rate : \" + \"{:.1%}\".format(df[\"target_numeric\"].mean()),\n            \"Mean ROI ratio: \" + \"{:.2f}x\".format(df[\"roi_ratio\"].mean()),\n            \"Median cost   : $\" + \"{:,.2f}\".format(df[CONFIG[\"COL_COST\"]].median()),\n            \"Median revenue: $\" + \"{:,.2f}\".format(df[CONFIG[\"COL_REVENUE\"]].median()),\n            \"\",\n            \"SLIDE 05 - PLATFORM PERFORMANCE\",\n            df.groupby(\"platform_clean\").agg(high_roi=(\"target_numeric\",\"mean\"), mean_roi=(\"roi_ratio\",\"mean\")).to_string(),\n            \"\",\n            \"SLIDE 06 - NICHE ANALYSIS\",\n            df.groupby(CONFIG[\"COL_NICHE\"])[\"roi_ratio\"].mean().sort_values(ascending=False).to_string(),\n            \"\",\n            \"SLIDE 07 - FEATURE ENGINEERING\",\n            \"12 engineered signals: roi_ratio, audience_quality_score, conversion_rate, etc.\",\n            \"\",\n            \"SLIDE 08 - ROI PREDICTION MODEL\",\n            \"Best model (cross-validated): saved to models/roi_classifier.pkl\",\n            \"\",\n            \"SLIDE 09 - REVENUE FORECASTING\",\n            \"GB Regressor (leakage-safe): saved to models/revenue_forecaster.pkl\",\n            \"\",\n            \"SLIDE 10 - INFLUENCER TIER MATRIX\",\n            df.groupby(\"influencer_tier\")[[\"roi_ratio\",\"audience_quality_score\"]].mean().to_string(),\n            \"\",\n            \"SLIDE 11 - PARTNERSHIP PRIORITY\",\n            df[\"partnership_priority\"].value_counts().to_string(),\n            \"\",\n            \"SLIDE 12 - INSIGHTS\",\n            \"See reports/insights.json for all machine-generated insights.\",\n            \"\",\n            \"SLIDE 13 - STRATEGIC RECOMMENDATIONS\",\n            \"1. Focus on top platform x niche combo.\",\n            \"2. Lock in Gold Tier long-term contracts.\",\n            \"3. Cap CPA at high-ROI benchmarks.\",\n            \"4. Audit zero-conversion campaigns.\",\n            \"\",\n            \"SLIDE 14 - TECHNICAL ARCHITECTURE\",\n            \"Data: ingest > clean > engineer > EDA\",\n            \"ML  : classify > segment > forecast\",\n            \"Biz : alerts > priority > recommendations\",\n            \"Out : Plotly dashboard + Excel + JSON APIs\",\n        ]\n        out = CONFIG[\"REPORTS_DIR\"] + \"executive_report.txt\"\n        with open(out, \"w\", encoding=\"utf-8\") as fh:\n            fh.write(\"\\n\".join(str(s) for s in lines) + \"\\n\")\n        print(\"Report written ->\", out)\n\n    if __name__ == \"__main__\":\n        generate_report()\n''').lstrip('\\n')\n\nwith open(\"generate_report.py\", \"w\", encoding=\"utf-8\") as _fh:\n    _fh.write(_report_code)\n\nprint(\"Created  ->  generate_report.py\")\n"))

