cells.append(_code_cell("# -- Phase 14: Write production scaffold ----------------------------------\nimport os\n\ndef _write(path: str, lines) -> None:\n    os.makedirs(os.path.dirname(path) or \".\", exist_ok=True)\n    with open(path, \"w\", encoding=\"utf-8\") as fh:\n        fh.write(\"\\n\".join(lines) + \"\\n\")\n\n# package __init__ files\nfor _pkg in [\n    \"src/data\", \"src/features\", \"src/models\",\n    \"src/analytics\", \"src/reporting\", \"config\",\n]:\n    os.makedirs(_pkg, exist_ok=True)\n    _write(f\"{_pkg}/__init__.py\", [\"# package init\"])\n\n# -- config/config.py -----------------------------------------------------\n_write(\"config/config.py\", [\n    \"CONFIG = {\",\n    '    \"RAW_CSV\":       \"data/raw/influencer_campaigns.csv\",',\n    '    \"PROCESSED_CSV\": \"data/processed/campaigns_clean.csv\",',\n    '    \"FEAT_CSV\":      \"data/processed/campaigns_features.csv\",',\n    '    \"REPORTS_DIR\":   \"reports/\",',\n    '    \"MODELS_DIR\":    \"models/\",',\n    '    \"COL_ID\":           \"Influencer_ID\",',\n    '    \"COL_PLATFORM\":     \"Platform\",',\n    '    \"COL_NICHE\":        \"Audience_Niche\",',\n    '    \"COL_FOLLOWERS\":    \"Follower_Count\",',\n    '    \"COL_ENGAGEMENT\":   \"Engagement_Rate_Pct\",',\n    '    \"COL_COMMENTS\":     \"Avg_Comments_Per_Post\",',\n    '    \"COL_COLLABS\":      \"Past_Brand_Collaborations\",',\n    '    \"COL_COST\":         \"Campaign_Cost_USD\",',\n    '    \"COL_DISCOUNT_USES\":\"Discount_Code_Uses\",',\n    '    \"COL_REVENUE\":      \"Revenue_Generated_USD\",',\n    '    \"COL_TARGET\":       \"High_ROI_Campaign\",',\n    '    \"RANDOM_STATE\": 42,',\n    '    \"TEST_SIZE\":    0.20,',\n    '    \"ANOMALY_CONT\": 0.08,',\n    '    \"ROI_HIGH_THRESHOLD\":      3.0,',\n    '    \"ROI_MEDIUM_THRESHOLD\":    1.5,',\n    '    \"ENGAGEMENT_HIGH\":         5.0,',\n    '    \"ENGAGEMENT_MEDIUM\":       2.0,',\n    '    \"FOLLOWER_MICRO\":          50_000,',\n    '    \"FOLLOWER_MACRO\":          500_000,',\n    '    \"CONVERSION_RATE_GOOD\":    0.005,',\n    '    \"COST_PER_USE_THRESHOLD\":  50.0,',\n    '    \"REV_PER_FOLLOWER_GOOD\":   0.01,',\n    '    \"COLLAB_EXPERIENCED\":      5,',\n    '    \"TARGET_MAP\":    {\"Yes\": 1, \"No\": 0},',\n    '    \"TARGET_LABELS\": {1: \"High ROI\", 0: \"Low ROI\"},',\n    \"}\",\n])\n\n# -- src/data/ingest.py ----------------------------------------------------\n_write(\"src/data/ingest.py\", [\n    \"import pandas as pd\",\n    \"\",\n    \"def load_and_validate(config: dict) -> pd.DataFrame:\",\n    \"    df = pd.read_csv(config['RAW_CSV'])\",\n    \"    print('Ingested', len(df), 'rows from', config['RAW_CSV'])\",\n    \"    return df\",\n])\n\n# -- src/data/clean.py -----------------------------------------------------\n_write(\"src/data/clean.py\", [\n    \"import pandas as pd\",\n    \"\",\n    \"def cap_outliers(s: pd.Series) -> pd.Series:\",\n    \"    q1, q3 = s.quantile(0.25), s.quantile(0.75)\",\n    \"    return s.clip(lower=q1 - 1.5*(q3-q1), upper=q3 + 1.5*(q3-q1))\",\n    \"\",\n    \"def clean(df: pd.DataFrame, config: dict) -> pd.DataFrame:\",\n    \"    df_c = df.copy()\",\n    \"    df_c['target_numeric'] = df_c[config['COL_TARGET']].map(config['TARGET_MAP']).fillna(0).astype(int)\",\n    \"    df_c['follower_tier']  = df_c[config['COL_FOLLOWERS']].apply(\",\n    \"        lambda x: 'Micro' if x < config['FOLLOWER_MICRO'] else ('Macro' if x < config['FOLLOWER_MACRO'] else 'Mega'))\",\n    \"    df_c['platform_clean'] = df_c[config['COL_PLATFORM']].astype(str).str.strip().str.title()\",\n    \"    for c in [config['COL_FOLLOWERS'], config['COL_COST'], config['COL_REVENUE'],\",\n    \"              config['COL_ENGAGEMENT'], config['COL_COMMENTS']]:\",\n    \"        df_c[c] = cap_outliers(pd.to_numeric(df_c[c], errors='coerce').fillna(0))\",\n    \"    df_c = df_c.drop_duplicates(subset=[config['COL_ID'], config['COL_COST']])\",\n    \"    df_c.to_csv(config['PROCESSED_CSV'], index=False)\",\n    \"    return df_c\",\n])\n\n# -- src/features/engineer.py ---------------------------------------------\n_write(\"src/features/engineer.py\", [\n    \"import numpy as np\",\n    \"import pandas as pd\",\n    \"\",\n    \"def engineer(df: pd.DataFrame, config: dict) -> pd.DataFrame:\",\n    \"    d = df.copy()\",\n    \"    _c  = d[config['COL_COST']].replace(0, 1)\",\n    \"    _f  = d[config['COL_FOLLOWERS']].replace(0, 1)\",\n    \"    _di = d[config['COL_DISCOUNT_USES']].replace(0, 1)\",\n    \"    _cm = d[config['COL_COMMENTS']].replace(0, 1)\",\n    \"    d['roi_ratio']                    = d[config['COL_REVENUE']] / _c\",\n    \"    d['cost_per_discount_use']        = d[config['COL_COST']] / _di\",\n    \"    d['revenue_per_follower']         = d[config['COL_REVENUE']] / _f\",\n    \"    d['conversion_rate']              = d[config['COL_DISCOUNT_USES']] / _f\",\n    \"    d['engagement_to_cost_efficiency']= (d[config['COL_ENGAGEMENT']] * d[config['COL_DISCOUNT_USES']]) / _c\",\n    \"    _eng  = d[config['COL_ENGAGEMENT']]\",\n    \"    _enorm= (_eng - _eng.min()) / (_eng.max() - _eng.min() + 1e-9)\",\n    \"    d['audience_quality_score']       = _enorm\",\n    \"    d['influencer_experience_score']  = np.log1p(d[config['COL_COLLABS']])\",\n    \"    d['revenue_per_comment']          = d[config['COL_REVENUE']] / _cm\",\n    \"    d['platform_niche_combo']         = d['platform_clean'] + '_' + d[config['COL_NICHE']].astype(str)\",\n    \"    d.to_csv(config['FEAT_CSV'], index=False)\",\n    \"    return d\",\n])\n\n# -- src/analytics/eda.py -------------------------------------------------\n_write(\"src/analytics/eda.py\", [\n    \"import matplotlib.pyplot as plt\",\n    \"import seaborn as sns\",\n    \"\",\n    \"def run_eda(df, config: dict) -> None:\",\n    \"    fig, ax = plt.subplots(figsize=(6, 4))\",\n    \"    sns.countplot(data=df, x=config['COL_TARGET'], ax=ax)\",\n    \"    ax.set_title('ROI Outcome Distribution')\",\n    \"    plt.tight_layout()\",\n    \"    plt.savefig(config['REPORTS_DIR'] + 'eda_01_roi_outcome_distribution.png', dpi=150)\",\n    \"    plt.close()\",\n    \"    print('EDA complete.')\",\n])\n\n# -- src/models/classify.py ------------------------------------------------\n_write(\"src/models/classify.py\", [\n    \"import joblib\",\n    \"import pandas as pd\",\n    \"from sklearn.ensemble import GradientBoostingClassifier\",\n    \"from sklearn.model_selection import train_test_split\",\n    \"from sklearn.metrics import accuracy_score\",\n    \"\",\n    \"FEATS = ['Follower_Count', 'Campaign_Cost_USD', 'Engagement_Rate_Pct',\",\n    \"         'Discount_Code_Uses', 'Past_Brand_Collaborations']\",\n    \"\",\n    \"def run_classification(df: pd.DataFrame, config: dict) -> pd.DataFrame:\",\n    \"    feats = [c for c in FEATS if c in df.columns]\",\n    \"    if 'roi_ratio' in df.columns: feats.append('roi_ratio')\",\n    \"    X, y = df[feats].fillna(0), df['target_numeric']\",\n    \"    if len(X) < 20:\",\n    \"        print('Insufficient data for classification'); return df\",\n    \"    X_tr, X_te, y_tr, y_te = train_test_split(\",\n    \"        X, y, test_size=config['TEST_SIZE'],\",\n    \"        stratify=y, random_state=config['RANDOM_STATE'])\",\n    \"    model = GradientBoostingClassifier(\",\n    \"        n_estimators=200, random_state=config['RANDOM_STATE'])\",\n    \"    model.fit(X_tr, y_tr)\",\n    \"    print(f'Classifier accuracy: {accuracy_score(y_te, model.predict(X_te)):.3f}')\",\n    \"    df['pred_high_roi']        = model.predict(X)\",\n    \"    df['pred_roi_probability'] = model.predict_proba(X)[:, 1]\",\n    \"    joblib.dump(model, config['MODELS_DIR'] + 'roi_classifier.pkl')\",\n    \"    joblib.dump(feats, config['MODELS_DIR'] + 'feature_cols.pkl')\",\n    \"    return df\",\n])\n\n# -- src/models/segment.py -------------------------------------------------\n_write(\"src/models/segment.py\", [\n    \"import joblib\",\n    \"import pandas as pd\",\n    \"from sklearn.cluster import KMeans\",\n    \"from sklearn.ensemble import IsolationForest\",\n    \"from sklearn.preprocessing import StandardScaler\",\n    \"\",\n    \"SEG_FEATS = ['roi_ratio', 'audience_quality_score',\",\n    \"             'conversion_rate', 'influencer_experience_score']\",\n    \"\",\n    \"def run_segmentation(df: pd.DataFrame, config: dict) -> pd.DataFrame:\",\n    \"    feats = [c for c in SEG_FEATS if c in df.columns]\",\n    \"    X = StandardScaler().fit_transform(df[feats].fillna(0))\",\n    \"    if len(X) < 20:\",\n    \"        print('Insufficient data for segmentation'); return df\",\n    \"    km = KMeans(n_clusters=3, n_init=10, random_state=config['RANDOM_STATE'])\",\n    \"    df['_cl'] = km.fit_predict(X)\",\n    \"    roi_by_cl = df.groupby('_cl')['roi_ratio'].mean().sort_values(ascending=False)\",\n    \"    tier_map  = {roi_by_cl.index[0]: 'Gold Tier',\",\n    \"                 roi_by_cl.index[1]: 'Silver Tier',\",\n    \"                 roi_by_cl.index[2]: 'Bronze Tier'}\",\n    \"    df['influencer_tier'] = df['_cl'].map(tier_map)\",\n    \"    df.drop(columns=['_cl'], inplace=True)\",\n    \"    iso = IsolationForest(contamination=config['ANOMALY_CONT'],\",\n    \"                          random_state=config['RANDOM_STATE'])\",\n    \"    df['is_campaign_anomaly'] = (iso.fit_predict(X) == -1).astype(int)\",\n    \"    joblib.dump(km,  config['MODELS_DIR'] + 'influencer_segmenter.pkl')\",\n    \"    joblib.dump(iso, config['MODELS_DIR'] + 'campaign_anomaly_detector.pkl')\",\n    \"    df.to_csv(config['FEAT_CSV'], index=False)\",\n    \"    return df\",\n])\n\n# -- src/models/forecast.py ------------------------------------------------\n_write(\"src/models/forecast.py\", [\n    \"import joblib\",\n    \"import pandas as pd\",\n    \"from sklearn.ensemble import GradientBoostingRegressor\",\n    \"from sklearn.metrics import mean_absolute_error, r2_score\",\n    \"from sklearn.model_selection import train_test_s