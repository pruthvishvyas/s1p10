cells.append(_md_cell("## Phase 1 - Data Ingestion & Validation"))

cells.append(_code_cell("# -- Phase 1: Ingest & validate --------------------------------------------\ndf = pd.read_csv(CONFIG[\"RAW_CSV\"])\n\nEXPECTED_COLS = [\n    CONFIG[\"COL_ID\"],        CONFIG[\"COL_PLATFORM\"],   CONFIG[\"COL_NICHE\"],\n    CONFIG[\"COL_FOLLOWERS\"], CONFIG[\"COL_ENGAGEMENT\"],  CONFIG[\"COL_COMMENTS\"],\n    CONFIG[\"COL_COLLABS\"],   CONFIG[\"COL_COST\"],         CONFIG[\"COL_DISCOUNT_USES\"],\n    CONFIG[\"COL_REVENUE\"],   CONFIG[\"COL_TARGET\"],\n]\n\nmissing_cols  = [c for c in EXPECTED_COLS if c not in df.columns]\nnull_summary  = df.isnull().sum()\nnull_cols     = null_summary[null_summary > 0]\ntarget_balance = df[CONFIG[\"COL_TARGET\"]].value_counts(normalize=True).to_dict()\n\nprint(\"-- VALIDATION SUMMARY ---------------------------------\")\nprint(f\"Rows      : {len(df)}\")\nprint(f\"Columns   : {len(df.columns)}\")\nprint(f\"Schema OK : {len(missing_cols) == 0}\")\nif missing_cols:\n    print(f\"Missing   : {missing_cols}\")\nif not null_cols.empty:\n    print(f\"Nulls     : {null_cols.to_dict()}\")\nprint(\"\\nTarget balance:\")\nfor k, v in target_balance.items():\n    print(f\"  {k}: {v:.1%}\")\nprint(\"\\nPlatform counts:\")\nprint(df[CONFIG[\"COL_PLATFORM\"]].value_counts().to_string())\nprint(\"\\nFollower stats:\")\nprint(df[CONFIG[\"COL_FOLLOWERS\"]].describe().to_string())\n"))

cells.append(_md_cell("## Phase 2 - Data Cleaning"))

cells.append(_code_cell("# -- Phase 2: Clean --------------------------------------------------------\nif \"df\" not in dir():\n    df = pd.read_csv(CONFIG[\"RAW_CSV\"])\n\ndf_clean = df.copy()\n\n# --- enforce dtypes ---\n_int_cols   = [CONFIG[\"COL_FOLLOWERS\"], CONFIG[\"COL_COMMENTS\"],\n               CONFIG[\"COL_COLLABS\"],   CONFIG[\"COL_DISCOUNT_USES\"]]\n_float_cols = [CONFIG[\"COL_ENGAGEMENT\"], CONFIG[\"COL_COST\"], CONFIG[\"COL_REVENUE\"]]\n_cat_cols   = [CONFIG[\"COL_PLATFORM\"],  CONFIG[\"COL_NICHE\"], CONFIG[\"COL_TARGET\"]]\n\nfor c in _int_cols:\n    df_clean[c] = pd.to_numeric(df_clean[c], errors=\"coerce\").fillna(0).astype(\"int64\")\nfor c in _float_cols:\n    df_clean[c] = pd.to_numeric(df_clean[c], errors=\"coerce\").fillna(0.0).astype(\"float64\")\nfor c in _cat_cols:\n    df_clean[c] = df_clean[c].astype(\"category\")\n\n# --- IQR outlier capping ---\ndef cap_outliers(series: pd.Series) -> pd.Series:\n    q1, q3 = series.quantile(0.25), series.quantile(0.75)\n    iqr = q3 - q1\n    return series.clip(lower=q1 - 1.5 * iqr, upper=q3 + 1.5 * iqr)\n\n_cap_cols = [CONFIG[\"COL_FOLLOWERS\"], CONFIG[\"COL_COST\"],\n             CONFIG[\"COL_REVENUE\"],    CONFIG[\"COL_ENGAGEMENT\"],\n             CONFIG[\"COL_COMMENTS\"]]\nfor c in _cap_cols:\n    orig_max = df_clean[c].max()\n    df_clean[c] = cap_outliers(df_clean[c])\n    print(f\"  {c}: max capped  {orig_max:.2f}  \u2192  {df_clean[c].max():.2f}\")\n\n# --- deduplication ---\nn_before = len(df_clean)\ndf_clean = df_clean.drop_duplicates(subset=[CONFIG[\"COL_ID\"], CONFIG[\"COL_COST\"]])\nprint(f\"Duplicates removed: {n_before - len(df_clean)}\")\n\n# --- derived columns ---\ndf_clean[\"target_label\"]   = (\n    df_clean[CONFIG[\"COL_TARGET\"]]\n    .map(CONFIG[\"TARGET_MAP\"])\n    .map(CONFIG[\"TARGET_LABELS\"])\n)\ndf_clean[\"target_numeric\"] = (\n    df_clean[CONFIG[\"COL_TARGET\"]].map(CONFIG[\"TARGET_MAP\"]).fillna(0).astype(int)\n)\n\ndef _follower_tier(f: int) -> str:\n    if f < CONFIG[\"FOLLOWER_MICRO\"]:  return \"Micro\"\n    if f < CONFIG[\"FOLLOWER_MACRO\"]:  return \"Macro\"\n    return \"Mega\"\n\ndf_clean[\"follower_tier\"]  = df_clean[CONFIG[\"COL_FOLLOWERS\"]].apply(_follower_tier)\ndf_clean[\"platform_clean\"] = df_clean[CONFIG[\"COL_PLATFORM\"]].astype(str).str.strip().str.title()\n\ndf_clean.to_csv(CONFIG[\"PROCESSED_CSV\"], index=False)\nprint(f\"Saved cleaned data \u2192 {CONFIG['PROCESSED_CSV']}  shape={df_clean.shape}\")\n"))

cells.append(_md_cell("## Phase 3 - Feature Engineering"))

cells.append(_code_cell("# -- Phase 3: Feature engineering -----------------------------------------\nif \"df_clean\" not in dir():\n    df_clean = pd.read_csv(CONFIG[\"PROCESSED_CSV\"])\n\ndf_feat = df_clean.copy()\n\n# safe denominators\n_c_cost = df_feat[CONFIG[\"COL_COST\"]].replace(0, 1)\n_c_foll = df_feat[CONFIG[\"COL_FOLLOWERS\"]].replace(0, 1)\n_c_disc = df_feat[CONFIG[\"COL_DISCOUNT_USES\"]].replace(0, 1)\n_c_comm = df_feat[CONFIG[\"COL_COMMENTS\"]].replace(0, 1)\n\n# 1. roi_ratio\ndf_feat[\"roi_ratio\"] = df_feat[CONFIG[\"COL_REVENUE\"]] / _c_cost\n\n# 2. cost_per_discount_use\ndf_feat[\"cost_per_discount_use\"] = df_feat[CONFIG[\"COL_COST\"]] / _c_disc\n\n# 3. revenue_per_follower\ndf_feat[\"revenue_per_follower\"] = df_feat[CONFIG[\"COL_REVENUE\"]] / _c_foll\n\n# 4. conversion_rate\ndf_feat[\"conversion_rate\"] = df_feat[CONFIG[\"COL_DISCOUNT_USES\"]] / _c_foll\n\n# 5. engagement_to_cost_efficiency\ndf_feat[\"engagement_to_cost_efficiency\"] = (\n    df_feat[CONFIG[\"COL_ENGAGEMENT\"]] * df_feat[CONFIG[\"COL_DISCOUNT_USES\"]]\n) / _c_cost\n\n# 6. audience_quality_score (composite)\ndef _min_max(s: pd.Series) -> pd.Series:\n    rng = s.max() - s.min()\n    return (s - s.min()) / rng if rng != 0 else pd.Series(0.0, index=s.index)\n\n_eng_norm  = _min_max(df_feat[CONFIG[\"COL_ENGAGEMENT\"]])\n_conv_norm = _min_max(df_feat[\"conversion_rate\"])\n_comm_norm = _min_max(df_feat[CONFIG[\"COL_COMMENTS\"]] / _c_foll)\ndf_feat[\"audience_quality_score\"] = (\n    0.4 * _eng_norm + 0.3 * _conv_norm + 0.3 * _comm_norm\n)\n\n# 7. influencer_experience_score\ndf_feat[\"influencer_experience_score\"] = np.log1p(df_feat[CONFIG[\"COL_COLLABS\"]])\n\n# 8. revenue_per_comment\ndf_feat[\"revenue_per_comment\"] = df_feat[CONFIG[\"COL_REVENUE\"]] / _c_comm\n\n# 9. cost_efficiency_tier\ndf_feat[\"cost_efficiency_tier\"] = pd.cut(\n    df_feat[\"cost_per_discount_use\"],\n    bins=[0, 25, 50, 100, np.inf],\n    labels=[\"Elite\", \"Good\", \"Fair\", \"Poor\"],\n    right=True,\n).astype(str)\n\n# 10. engagement_tier\ndef _eng_tier(e: float) -> str:\n    if e >= CONFIG[\"ENGAGEMENT_HIGH\"]:   return \"Elite\"\n    if e >= CONFIG[\"ENGAGEMENT_MEDIUM\"]: return \"Healthy\"\n    return \"Low\"\n\ndf_feat[\"engagement_tier\"] = df_feat[CONFIG[\"COL_ENGAGEMENT\"]].apply(_eng_tier)\n\n# 11. platform_niche_combo\ndf_feat[\"platform_niche_combo\"] = (\n    df_feat[\"platform_clean\"] + \"_\" + df_feat[CONFIG[\"COL_NICHE\"]].astype(str)\n)\n\ndf_feat.to_csv(CONFIG[\"FEAT_CSV\"], index=False)\n_new_cols = [c for c in df_feat.columns if c not in df_clean.columns]\nprint(f\"Feature engineering complete.  New columns ({len(_new_cols)}):\")\nprint(\"  \" + \", \".join(_new_cols))\n"))

cells.append(_md_cell("## Phase 4 - Exploratory Data Analysis"))

cells.append(_code_cell("# -- Phase 4: EDA ---------------------------------------------------------\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\nif \"df_feat\" not in dir():\n    df_feat = pd.read_csv(CONFIG[\"FEAT_CSV\"])\n\nplt.rcParams.update({\n    \"figure.dpi\":        150,\n    \"axes.spines.top\":   False,\n    \"axes.spines.right\": False,\n})\n\ndef _save(name: str) -> None:\n    plt.tight_layout()\n    plt.savefig(CONFIG[\"REPORTS_DIR\"] + name, dpi=150, bbox_inches=\"tight\")\n    plt.show()\n    plt.close()\n\n# 1 - ROI outcome distribution\nfig, ax = plt.subplots(figsize=(6, 4))\nsns.countplot(data=df_feat, x=CONFIG[\"COL_TARGET\"], palette=\"viridis\", ax=ax)\nax.set_title(\"ROI Outcome Distribution\")\n_save(\"eda_01_roi_outcome_distribution.png\")\n\n# 2 - ROI rate by platform\nfig, ax = plt.subplots(figsize=(7, 4))\ndf_feat.groupby(\"platform_clean\")[\"target_numeric\"].mean().plot(kind=\"bar\", color=\"royalblue\", ax=ax)\nax.set_title(\"ROI Rate per Platform\")\nax.set_ylabel(\"% High ROI\")\nax.set_xlabel(\"\")\n_save(\"eda_02_platform_roi_rate.png\")\n\n# 3 - ROI rate by niche\nfig, ax = plt.subplots(figsize=(7, 5))\ndf_feat.groupby(CONFIG[\"COL_NICHE\"])[\"target_numeric\"].mean().sort_values().plot(kind=\"barh\", color=\"teal\", ax=ax)\nax.set_title(\"ROI Rate per Audience Niche\")\nax.set_xlabel(\"% High ROI\")\n_save(\"eda_03_niche_roi_rate.png\")\n\n# 4 - Follower tier ROI\nfig, ax = plt.subplots(figsize=(7, 4))\n_tier_order = [\"Micro\", \"Macro\", \"Mega\"]\nsns.barplot(data=df_feat, x=\"follower_tier\", y=\"target_numeric\",\n            order=[t for t in _tier_order if t in df_feat[\"follower_tier\"].unique()],\n            estimator=\"mean\", errorbar=None, palette=\"magma\", ax=ax)\nax.set_title(\"ROI Rate across Follower Tiers\")\n_save(\"eda_04_follower_tier_roi.png\")\n\n# 5 - Engagement vs ROI scatter\nfig, ax = plt.subplots(figsize=(7, 5))\nsns.scatterplot(data=df_feat, x=CONFIG[\"COL_ENGAGEMENT\"], y=\"roi_ratio\",\n                hue=CONFIG[\"COL_TARGET\"], alpha=0.65, ax=ax)\nax.set_title(\"Engagement Rate vs ROI Ratio\")\n_save(\"eda_05_engagement_vs_roi_scatter.png\")\n\n# 6 - Cost vs revenue\nfig, ax = plt.subplots(figsize=(7, 5))\nsns.scatterplot(data=df_feat, x=CONFIG[\"COL_COST\"], y=CONFIG[\"COL_REVENUE\"],\n                hue=CONFIG[\"COL_TARGET\"], alpha=0.65, ax=ax)\n_max_val = max(df_feat[CONFIG[\"COL_COST\"]].max(), df_feat[CONFIG[\"COL_REVENUE\"]].max())\nax.plot([0, _max_val], [0, _max_val], \"r--\", label=\"Breakeven\")\nax.set_title(\"Campaign Cost vs Revenue Generated\")\nax.legend()\n_save(\"eda_06_cost_vs_revenue_scatter.png\")\n\n# 7 - Audience quality by platform\nfig, ax = plt.subplots(figsize=(7, 4))\nsns.boxplot(data=df_feat, x=\"platform_clean\", y=\"audience_quality_score\", palette=\"Set2\", ax=ax)\nax.set_title(\"Audience Quality Score by Platform\")\n_save(\"eda_07_audience_quality_by_platform.png\")\n\n# 8 - Correlation heatmap\nfig, ax = plt.subplots(figsize=(10, 8))\n_num_cols = df_feat.select_dtypes(include=[np.number]).columns\n_corr     = df_feat[_num_cols].corr()\n_mask     = np.triu(np.ones_like(_corr, dtype=bool))\nsns.heatmap(_corr, mask=_mask, cmap=\"RdYlGn\", annot=False, ax=ax)\nax.set_title(\"Correlation Heatmap\")\n_save(\"eda_08_correlation_heatmap.png\")\n\n# 9 - Cost efficiency tier breakdown\nfig, ax = plt.subplots(figsize=(7, 4))\npd.crosstab(df_feat[\"cost_efficiency_tier\"], df_feat[CONFIG[\"COL_TARGET\"]],\n            normalize=\"index\").plot(kind=\"bar\", stacked=True, ax=ax)\nax.set_title(\"Cost Efficiency Tier vs ROI Outcome\")\nax.legend(bbox_to_anchor=(1.05, 1))\n_save(\"eda_09_cost_efficiency_tier_breakdown.png\")\n\n# 10 - Platform \u00d7 niche ROI heatmap\nfig, ax = plt.subplots(figsize=(8, 6))\n_pivot = df_feat.pivot_table(\n    index=\"platform_clean\", columns=CONFIG[\"COL_NICHE\"],\n    values=\"roi_ratio\", aggfunc=\"mean\"\n)\nsns.heatmap(_pivot, cmap=\"YlOrRd\", annot=True, fmt=\".2f\", ax=ax)\nax.set_title(\"Mean ROI Ratio: Platform \u00d7 Niche\")\n_save(\"eda_10_platform_niche_roi_heatmap.png\")\n\nprint(\"EDA complete - 10 charts saved to\", CONFIG[\"REPORTS_DIR\"])\n"))

cells.append(_md_cell("## Phase 5 - ROI Classification Model"))

cells.append(_code_cell("# -- Phase 5: Classification -----------------------------------------------\nimport joblib\nfrom sklearn.ensemble import (\n    GradientBoostingClassifier,\n    RandomForestClassifier,\n)\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import (\n    accuracy_score,\n    auc,\n    classification_report,\n    confusion_matrix,\n    f1_score,\n    roc_curve,\n)\nfrom sklearn.model_selection import (\n    StratifiedKFold,\n    cross_val_score,\n    train_test_split,\n)\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.preprocessing import StandardScaler\n\nif \"df_feat\" not in dir():\n    df_feat = pd.read_csv(CONFIG[\"FEAT_CSV\"])\n\n_CANDIDATE_FEATS = [\n    \"Follower_Count\",          \"Engagement_Rate_Pct\",\n    \"Avg_Comments_Per_Post\",   \"Past_Brand_Collaborations\",\n    \"Campaign_Cost_USD\",        \"Discount_Code_Uses\",\n    \"roi_ratio\",                \"cost_per_discount_use\",\n    \"revenue_per_follower\",     \"conversion_rate\",\n    \"engagement_to_cost_efficiency\",\n    \"audience_quality_score\",   \"influencer_experience_score\",\n    \"revenue_per_comment\",\n]\nFEATURE_COLS = [c for c in _CANDIDATE_FEATS if c in df_feat.columns]\n\nX = df_feat[FEATURE_COLS].fillna(0)\ny = df_feat[\"target_numeric\"]\n\n# Rule-based baseline\n_baseline = (df_feat[\"roi_ratio\"] >= CONFIG[\"ROI_HIGH_THRESHOLD\"]).astype(int)\nprint(f\"Baseline rule accuracy : {accuracy_score(y, _baseline):.3f}\\n\")\n\nX_train, X_test, y_train, y_test = train_test_split(\n    X, y,\n    test_size=CONFIG[\"TEST_SIZE\"],\n    stratify=y,\n    random_state=CONFIG[\"RANDOM_STATE\"],\n)\nassert len(X_train) >= 20, \"Insufficient training data\"\n\n_models = {\n    \"Logistic Regression\": Pipeline([\n        (\"scaler\", StandardScaler()),\n        (\"lr\",     LogisticRegression(max_iter=1000, random_state=CONFIG[\"RANDOM_STATE\"])),\n    ]),\n    \"Random Forest\": RandomForestClassifier(\n        n_estimators=100, random_state=CONFIG[\"RANDOM_STATE\"]\n    ),\n    \"Gradient Boosting\": GradientBoostingClassifier(\n        n_estimators=200, random_state=CONFIG[\"RANDOM_STATE\"]\n    ),\n}\n\n_cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=CONFIG[\"RANDOM_STATE\"])\n\nbest_auc        = -1.0\nbest_model_name = \"\"\nbest_model      = None\n\nfor name, model in _models.items():\n    _cv_auc = cross_val_score(model, X_train, y_train, cv=_cv, scoring=\"roc_auc\")\n    model.fit(X_train, y_train)\n    _y_pred = model.predict(X_test)\n    _y_prob = model.predict_proba(X_test)[:, 1]\n    _fpr, _tpr, _ = roc_curve(y_test, _y_prob)\n    _test_auc = auc(_fpr, _tpr)\n    _acc = accuracy_score(y_test, _y_pred)\n    _f1  = f1_score(y_test, _y_pred, zero_division=0)\n    print(\n        f\"{name:<22} | CV-AUC {_cv_auc.mean():.3f}\u00b1{_cv_auc.std():.3f}\"\n        f\" | Test-AUC {_test_auc:.3f} | Acc {_acc:.3f} | F1 {_f1:.3f}\"\n    )\n    if _test_auc > best_auc:\n        best_auc, best_model_name, best_model = _test_auc, name, model\n\nprint(f\"\\nBest model: {best_model_name}  (AUC={best_auc:.3f})\")\n\njoblib.dump(best_model,   CONFIG[\"MODELS_DIR\"] + \"roi_classifier.pkl\")\njoblib.dump(FEATURE_COLS, CONFIG[\"MODELS_DIR\"] + \"feature_cols.pkl\")\n\n_y_test_pred = best_model.predict(X_test)\n_y_test_prob = best_model.predict_proba(X_test)[:, 1]\n\n# -- evaluation plots ------------------------------------------------------\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))\n\n_cm = confusion_matrix(y_test, _y_test_pred)\nsns.heatmap(_cm, annot=True, fmt=\"d\", cmap=\"Blues\", ax=ax1,\n            xticklabels=[\"Low ROI\", \"High ROI\"],\n            yticklabels=[\"Low ROI\", \"High ROI\"])\nax1.set_title(\"Confusion Matrix\")\nax1.set_ylabel(\"Actual\")\nax1.set_xlabel(\"Predicted\")\n\n_fpr, _tpr, _ = roc_curve(y_test, _y_test_prob)\nax2.plot(_fpr, _tpr, label=f\"AUC = {best_auc:.3f}\", color=\"darkorange\")\nax2.plot([0, 1], [0, 1], \"k--\")\nax2.set_title(\"ROC Curve\")\nax2.set_xlabel(\"False Positive Rate\")\nax2.set_ylabel(\"True Positive Rate\")\nax2.legend(loc=\"lower right\")\n\nplt.tight_layout()\nplt.savefig(CONFIG[\"REPORTS_DIR\"] + \"ml_01_classifier_eval.png\", dpi=150)\nplt.show()\nplt.close()\n\n# -- feature importances ---------------------------------------------------\nif hasattr(best_model, \"feature_importances_\"):\n    _imps = best_model.feature_importances_\nelse:\n    _imps = np.abs(best_model.named_steps[\"lr\"].coef_[0])\n\n_feat_imp = (\n    pd.Series(_imps, index=FEATURE_COLS)\n    .sort_values(ascending=True)\n    .tail(15)\n)\nfig, ax = plt.subplots(figsize=(8, 6))\n_feat_imp.plot(kind=\"barh\", color=\"purple\", ax=ax)\nax.set_title(\"Top Feature Importances\")\nplt.tight_layout()\nplt.savefig(CONFIG[\"REPORTS_DIR\"] + \"ml_02_feature_importance.png\", dpi=150)\nplt.show()\nplt.close()\n\ndf_feat[\"pred_high_roi\"]        = best_model.predict(X)\ndf_feat[\"pred_roi_probability\"] = best_model.predict_proba(X)[:, 1]\n\nprint(\"\\nClassification Report:\")\nprint(classification_report(y_test, _y_test_pred, target_names=[\"Low ROI\", \"High ROI\"]))\n"))

cells.append(_md_cell("## Phase 6 - Influencer Segmentation & Anomaly Detection"))

cells.append(_code_cell("# -- Phase 6: Segmentation & anomaly detection -----------------------------\nfrom sklearn.cluster import KMeans\nfrom sklearn.decomposition import PCA\nfrom sklearn.ensemble import IsolationForest\n\nif \"df_feat\" not in dir():\n    df_feat = pd.read_csv(CONFIG[\"FEAT_CSV\"])\n\n_SEG_FEATS = [\n    \"audience_quality_score\",    \"roi_ratio\",\n    \"conversion_rate\",            \"influencer_experience_score\",\n    \"cost_per_discount_use\",\n]\n_SEG_FEATS = [c for c in _SEG_FEATS if c in df_feat.columns]\nX_seg_raw = df_feat[_SEG_FEATS].fillna(0)\n\n_seg_scaler = StandardScaler()\nX_seg = _seg_scaler.fit_transform(X_seg_raw)\nassert len(X_seg) >= 20, \"Insufficient data for clustering\"\n\n# -- KMeans ----------------------------------------------------------------\n_kmeans = KMeans(n_clusters=3, n_init=10, random_state=CONFIG[\"RANDOM_STATE\"])\ndf_feat[\"_cluster\"] = _kmeans.fit_predict(X_seg)\n\n_cluster_roi = (\n    df_feat.groupby(\"_cluster\")[\"roi_ratio\"]\n    .mean()\n    .sort_values(ascending=False)\n)\n_tier_map = {\n    _cluster_roi.index[0]: \"Gold Tier\",\n    _cluster_roi.index[1]: \"Silver Tier\",\n    _cluster_roi.index[2]: \"Bronze Tier\",\n}\ndf_feat[\"influencer_tier\"] = df_feat[\"_cluster\"].map(_tier_map)\ndf_feat.drop(columns=[\"_cluster\"], inplace=True)\n\n# -- Isolation Forest ------------------------------------------------------\n_iso = IsolationForest(\n    contamination=CONFIG[\"ANOMALY_CONT\"],\n    random_state=CONFIG[\"RANDOM_STATE\"],\n)\ndf_feat[\"is_campaign_anomaly\"] = (_iso.fit_predict(X_seg) == -1).astype(int)\n\n# -- PCA for viz -----------------------------------------------------------\n_pca = PCA(n_components=2, random_state=CONFIG[\"RANDOM_STATE\"])\n_Xpca = _pca.fit_transform(X_seg)\ndf_feat[\"pca_1\"] = _Xpca[:, 0]\ndf_feat[\"pca_2\"] = _Xpca[:, 1]\n\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\n_palette = {\"Gold Tier\": \"gold\", \"Silver Tier\": \"silver\", \"Bronze Tier\": \"peru\"}\nsns.scatterplot(data=df_feat, x=\"pca_1\", y=\"pca_2\",\n                hue=\"influencer_tier\", palette=_palette, ax=ax1, alpha=0.7)\nax1.set_title(\"Influencer Tier Clusters (PCA)\")\n\nsns.scatterplot(data=df_feat, x=\"pca_1\", y=\"pca_2\",\n                hue=\"is_campaign_anomaly\",\n                palette={0: \"lightblue\", 1: \"red\"}, ax=ax2, alpha=0.7)\nax2.set_title(\"Campaign Anomaly Detection\")\n\nplt.tight_layout()\nplt.savefig(CONFIG[\"REPORTS_DIR\"] + \"ml_03_influencer_segments.png\", dpi=150)\nplt.show()\nplt.close()\n\nprint(\"Tier summary:\")\nprint(\n    df_feat.groupby(\"influencer_tier\")[\n        [\"roi_ratio\", \"audience_quality_score\", \"cost_per_discount_use\"]\n    ].mean().to_string()\n)\nprint(f\"\\nAnomalies detected: {df_feat['is_campaign_anomaly'].sum()}\")\n\njoblib.dump(_kmeans, CONFIG[\"MODELS_DIR\"] + \"influencer_segmenter.pkl\")\njoblib.dump(_iso,    CONFIG[\"MODELS_DIR\"] + \"campaign_anomaly_detector.pkl\")\ndf_feat.to_csv(CONFIG[\"FEAT_CSV\"], index=False)\n"))

cells.append(_md_cell("## Phase 7 - Revenue Forecasting"))

cells.append(_code_cell("# -- Phase 7: Revenue forecasting -----------------------------------------\nfrom sklearn.ensemble import GradientBoostingRegressor\nfrom sklearn.metrics import mean_absolute_error, mean_absolute_percentage_error, r2_score\n\nif \"df_feat\" not in dir():\n    df_feat = pd.read_csv(CONFIG[\"FEAT_CSV\"])\n\n# Exclude roi_ratio - it is derived from revenue (target leakage)\n_FORECAST_FEATS = [c for c in FEATURE_COLS if c != \"roi_ratio\" and c in df_feat.columns]\n\nX_reg = df_feat[_FORECAST_FEATS].fillna(0)\ny_reg = df_feat[CONFIG[\"COL_REVENUE\"]]\n\nX_tr, X_te, y_tr, y_te = train_test_split(\n    X_reg, y_reg,\n    test_size=CONFIG[\"TEST_SIZE\"],\n    random_state=CONFIG[\"RANDOM_STATE\"],\n)\nassert len(X_tr) >= 20, \"Insufficient data for regression\"\n\n_gb_reg = GradientBoostingRegressor(n_estimators=200, random_state=CONFIG[\"RANDOM_STATE\"])\n_gb_reg.fit(X_tr, y_tr)\n_y_pred_reg = _gb_reg.predict(X_te)\n\n_mae  = mean_absolute_error(y_te, _y_pred_reg)\n_r2   = r2_score(y_te, _y_pred_reg)\n_mape = mean_absolute_percentage_error(y_te, _y_pred_reg)\n\nprint(f\"Revenue Forecast  MAE : ${_mae:,.2f}\")\nprint(f\"Revenue Forecast  R\u00b2  : {_r2:.4f}\")\nprint(f\"Revenue Forecast  MAPE: {_mape:.2%}\")\n\ndf_feat[\"predicted_revenue_usd\"] = _gb_reg.predict(X_reg)\njoblib.dump(_gb_reg, CONFIG[\"MODELS_DIR\"] + \"revenue_forecaster.pkl\")\n\nprint(\"\\nPlatform ROI summary:\")\nprint(\n    df_feat.groupby(\"platform_clean\").agg(\n        mean_revenue=(CONFIG[\"COL_REVENUE\"], \"mean\"),\n        mean_cost=(CONFIG[\"COL_COST\"], \"mean\"),\n        mean_roi=(\"roi_ratio\", \"mean\"),\n        high_roi_rate=(\"target_numeric\", \"mean\"),\n    ).sort_values(\"mean_roi\", ascending=False).to_string()\n)\n\nprint(\"\\nNiche ROI summary:\")\nprint(\n    df_feat.groupby(CONFIG[\"COL_NICHE\"]).agg(\n        mean_revenue=(CONFIG[\"COL_REVENUE\"], \"mean\"),\n        mean_cost=(CONFIG[\"COL_COST\"], \"mean\"),\n        mean_roi=(\"roi_ratio\", \"mean\"),\n        high_roi_rate=(\"target_numeric\", \"mean\"),\n    ).sort_values(\"mean_roi\", ascending=False).to_string()\n)\n\n# evaluation plots\nfig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))\n\nax1.scatter(y_te, _y_pred_reg, alpha=0.55, color=\"darkgreen\")\n_lo = min(y_te.min(), _y_pred_reg.min())\n_hi = max(y_te.max(), _y_pred_reg.max())\nax1.plot([_lo, _hi], [_lo, _hi], \"r--\")\nax1.set_title(\"Actual vs Predicted Revenue\")\nax1.set_xlabel(\"Actual ($)\")\nax1.set_ylabel(\"Predicted ($)\")\n\n_residuals = y_te.values - _y_pred_reg\nsns.histplot(_residuals, kde=True, ax=ax2, color=\"orange\")\nax2.set_title(\"Residuals Distribution\")\nax2.set_xlabel(\"Error ($)\")\n\nplt.tight_layout()\nplt.savefig(CONFIG[\"REPORTS_DIR\"] + \"ml_04_revenue_forecast_eval.png\", dpi=150)\nplt.show()\nplt.close()\n"))

cells.append(_md_cell("## Phase 8 - Business Logic & Partnership Routing"))

cells.append(_code_cell("# -- Phase 8: Business logic -----------------------------------------------\nif \"df_feat\" not in dir():\n    df_feat = pd.read_csv(CONFIG[\"FEAT_CSV\"])\n\n_BIZ = {\n    \"roi_high\":              CONFIG[\"ROI_HIGH_THRESHOLD\"],\n    \"roi_medium\":            CONFIG[\"ROI_MEDIUM_THRESHOLD\"],\n    \"engagement_high\":       CONFIG[\"ENGAGEMENT_HIGH\"],\n    \"engagement_low\":        1.0,\n    \"cost_per_use_good\":     CONFIG[\"COST_PER_USE_THRESHOLD\"],\n    \"cost_per_use_alarm\":    200.0,\n    \"conversion_good\":       CONFIG[\"CONVERSION_RATE_GOOD\"],\n    \"experience_low\":        2,\n    \"audience_quality_high\": 0.7,\n}\n\ndef _campaign_alerts(row: pd.Series) -> str:\n    a = []\n    if row[\"roi_ratio\"] >= _BIZ[\"roi_high\"]:\n        a.append(\"HIGH_ROI_CONFIRMED\")\n    if row[CONFIG[\"COL_ENGAGEMENT\"]] >= _BIZ[\"engagement_high\"]:\n        a.append(\"STRONG_ENGAGEMENT\")\n    if row[\"audience_quality_score\"] >= _BIZ[\"audience_quality_high\"]:\n        a.append(\"ELITE_AUDIENCE_QUALITY\")\n    if row[\"cost_per_discount_use\"] <= _BIZ[\"cost_per_use_good\"]:\n        a.append(\"LOW_COST_PER_CONVERSION\")\n    if row[\"conversion_rate\"] >= _BIZ[\"conversion_good\"]:\n        a.append(\"HIGH_CONVERSION_RATE\")\n    # risk signals\n    if row[\"roi_ratio\"] < 1.0:\n        a.append(\"NEGATIVE_ROI\")\n    if row[CONFIG[\"COL_ENGAGEMENT\"]] < _BIZ[\"engagement_low\"]:\n        a.append(\"POOR_ENGAGEMENT\")\n    if row[\"cost_per_discount_use\"] > _BIZ[\"cost_per_use_alarm\"]:\n        a.append(\"EXPENSIVE_CONVERSIONS\")\n    if row[CONFIG[\"COL_DISCOUNT_USES\"]] == 0:\n        a.append(\"ZERO_CONVERSIONS\")\n    if row[CONFIG[\"COL_COLLABS\"]] < _BIZ[\"experience_low\"]:\n        a.append(\"INEXPERIENCED_INFLUENCER\")\n    if row.get(\"is_campaign_anomaly\", 0) == 1:\n        a.append(\"ANOMALOUS_CAMPAIGN\")\n    return \"|\".join(a) if a else \"NO_ALERTS\"\n\ndef _partnership_priority(alerts_str: str) -> str:\n    a = set(alerts_str.split(\"|\"))\n    if \"HIGH_ROI_CONFIRMED\" in a and (\n        \"STRONG_ENGAGEMENT\" in a or \"ELITE_AUDIENCE_QUALITY\" in a\n    ):\n        return \"P1_STRATEGIC_PARTNER\"\n    if \"HIGH_ROI_CONFIRMED\" in a or (\n        \"STRONG_ENGAGEMENT\" in a and \"LOW_COST_PER_CONVERSION\" in a\n    ):\n        return \"P2_RECOMMENDED\"\n    if \"NEGATIVE_ROI\" in a and (\n        \"POOR_ENGAGEMENT\" in a or \"ZERO_CONVERSIONS\" in a\n    ):\n        return \"P5_DO_NOT_REBOOK\"\n    if a & {\"NEGATIVE_ROI\", \"EXPENSIVE_CONVERSIONS\", \"ZERO_CONVERSIONS\"}:\n        return \"P4_REVIEW_REQUIRED\"\n    return \"P3_MONITOR\"\n\ndef _recommendation(row: pd.Series) -> str:\n    a   = set(row[\"campaign_alerts\"].split(\"|\"))\n    pri = row[\"partnership_priority\"]\n    recs = []\n    if \"HIGH_ROI_CONFIRMED\" in a:\n        recs.append(\"Prioritise for next campaign cycle - proven high-ROI track record\")\n    if \"ELITE_AUDIENCE_QUALITY\" in a:\n        recs.append(\"Negotiate preferred rate - consistent performance justifies investment\")\n    if \"INEXPERIENCED_INFLUENCER\" in a and pri == \"P3_MONITOR\":\n        recs.append(\"A/B test with smaller budget before full commitment\")\n    if \"POOR_ENGAGEMENT\" in a:\n        recs.append(\"Review brief - low engagement indicates content-audience mismatch\")\n    if \"EXPENSIVE_CONVERSIONS\" in a:\n        recs.append(\"Optimise discount code strategy - high CPA detected\")\n    if \"ZERO_CONVERSIONS\" in a:\n        recs.append(\"Audit audience authenticity - zero conversions despite reach\")\n    if \"NEGATIVE_ROI\" in a and \"STRONG_ENGAGEMENT\" in a:\n        recs.append(\"Test this influencer on alternative platform\")\n    if \"ANOMALOUS_CAMPAIGN\" in a:\n        recs.append(\"Schedule review - anomalous spend/revenue pattern flagged\")\n    return \"; \".join(recs) if recs else \"Monitor performance\"\n\ndf_feat[\"campaign_alerts\"]        = df_feat.apply(_campaign_alerts, axis=1)\ndf_feat[\"partnership_priority\"]   = df_feat[\"campaign_alerts\"].apply(_partnership_priority)\ndf_feat[\"campaign_recommendation\"]= df_feat.apply(_recommendation, axis=1)\n\nprint(\"Partnership priority distribution:\")\nprint(\n    df_feat.groupby(\"partnership_priority\")\n    .agg(count=(\"roi_ratio\", \"count\"), mean_roi=(\"roi_ratio\", \"mean\"))\n    .to_string()\n)\n\nfig, ax = plt.subplots(figsize=(8, 5))\ndf_feat[\"partnership_priority\"].value_counts().plot(kind=\"bar\", color=\"indigo\", ax=ax)\nax.set_title(\"Partnership Priority Distribution\")\nplt.tight_layout()\nplt.savefig(CONFIG[\"REPORTS_DIR\"] + \"biz_01_partnership_priorities.png\", dpi=150)\nplt.show()\nplt.close()\n\ndf_feat.to_csv(CONFIG[\"FEAT_CSV\"], index=False)\n"))

cells.append(_md_cell("## Phase 9 - Automated Insights"))

cells.append(_code_cell("# -- Phase 9: Insights -----------------------------------------------------\nimport json\n\nif \"df_feat\" not in dir():\n    df_feat = pd.read_csv(CONFIG[\"FEAT_CSV\"])\n\ninsights: list[dict] = []\n\ndef _add(category: str, finding: str, evidence: str, action: str, severity: str) -> None:\n    insights.append({\n        \"category\": category,\n        \"finding\":  finding,\n        \"evidence\": evidence,\n        \"action\":   action,\n        \"severity\": severity,\n    })\n\n# 1. Overall ROI prevalence\n_roi_rate = df_feat[\"target_numeric\"].mean()\n_add(\"CAMPAIGN_ROI_PREVALENCE\",\n     f\"Overall high-ROI rate is {_roi_rate:.1%}.\",\n     f\"{_roi_rate:.1%} of {len(df_feat)} campaigns exceed ROI threshold.\",\n     \"Adjust budget allocations to favour proven segments.\",\n     \"HIGH\")\n\n# 2. Best platform\n_plat_roi = df_feat.groupby(\"platform_clean\")[\"target_numeric\"].mean().sort_values(ascending=False)\n_best_p = _plat_roi.index[0] if len(_plat_roi) > 0 else \"N/A\"\n_add(\"BEST_PLATFORM\",\n     f\"{_best_p} delivers the highest high-ROI campaign rate.\",\n     f\"High-ROI rate: {_plat_roi.iloc[0]:.1%}.\",\n     f\"Shift at least 20 % of discretionary budget to {_best_p}.\",\n     \"HIGH\")\n\n# 3. Best niche\n_niche_roi = df_feat.groupby(CONFIG[\"COL_NICHE\"])[\"roi_ratio\"].mean().sort_values(ascending=False)\n_best_n = _niche_roi.index[0] if len(_niche_roi) > 0 else \"N/A\"\n_add(\"BEST_NICHE\",\n     f\"{_best_n} is the highest-performing audience niche.\",\n     f\"Mean ROI ratio: {_niche_roi.iloc[0]:.2f}x.\",\n     \"Prioritise creators whose primary niche is \" + _best_n + \".\",\n     \"HIGH\")\n\n# 4. Micro vs mega\n_tier_roi = df_feat.groupby(\"follower_tier\")[\"target_numeric\"].mean()\n_micro_v  = _tier_roi.get(\"Micro\", 0.0)\n_mega_v   = _tier_roi.get(\"Mega\",  0.0)\n_add(\"MICRO_VS_MEGA\",\n     f\"Micro ({_micro_v:.1%}) vs Mega ({_mega_v:.1%}) high-ROI rate.\",\n     \"Based on follower tier segmentation across all campaigns.\",\n     \"Optimise tier mix toward best-performing segment.\",\n     \"HIGH\")\n\n# 5. Engagement-ROI correlation\n_corr = df_feat[CONFIG[\"COL_ENGAGEMENT\"]].corr(df_feat[\"roi_ratio\"])\n_add(\"ENGAGEMENT_ROI_CORRELATION\",\n     f\"Engagement-rate and ROI ratio correlation: r={_corr:.2f}.\",\n     \"Pearson correlation on full dataset.\",\n     \"Use engagement rate as a leading signal in influencer shortlisting.\",\n     \"MEDIUM\")\n\n# 6. Cost efficiency\n_cost_hi = df_feat.loc[df_feat[\"target_numeric\"] == 1, \"cost_per_discount_use\"].median()\n_cost_lo = df_feat.loc[df_feat[\"target_numeric\"] == 0, \"cost_per_discount_use\"].median()\n_add(\"COST_EFFICIENCY_FINDING\",\n     \"High-ROI campaigns have a lower median cost per conversion.\",\n     f\"High-ROI median CPA ${_cost_hi:.2f} vs Low-ROI ${_cost_lo:.2f}.\",\n     f\"Set maximum acceptable CPA at ${_cost_hi * 1.25:.2f}.\",\n     \"HIGH\")\n\n# 7. Best platform \u00d7 niche combo\n_combo_roi = df_feat.groupby(\"platform_niche_combo\")[\"roi_ratio\"].mean().sort_values(ascending=False)\n_best_c = _combo_roi.index[0] if len(_combo_roi) > 0 else \"N/A\"\n_add(\"TOP_PLATFORM_NICHE_COMBO\",\n     f\"Top-performing combination: {_best_c}.\",\n     f\"Mean ROI ratio {_combo_roi.iloc[0]:.2f}x.\",\n     f\"Brief vertical campaigns targeting {_best_c.replace('_', ' / ')}.\",\n     \"HIGH\")\n\n# 8. Anomaly profile\n_anom_cost = df_feat.loc[df_feat[\"is_campaign_anomaly\"] == 1, CONFIG[\"COL_COST\"]].mean()\n_norm_cost = df_feat.loc[df_feat[\"is_campaign_anomaly\"] == 0, CONFIG[\"COL_COST\"]].mean()\n_add(\"ANOMALY_PROFILE\",\n     \"Anomalous campaigns show distinctly different spend patterns.\",\n     f\"Anomaly mean cost ${_anom_cost:,.0f} vs normal ${_norm_cost:,.0f}.\",\n     \"Audit all flagged anomalous campaigns before rebooking.\",\n     \"MEDIUM\")\n\n# 9. Model readiness\n_add(\"MODEL_PERFORMANCE\",\n     \"Predictive classifier and revenue forecaster are trained and saved.\",\n     \"Cross-validated on stratified hold-out splits.\",\n     \"Deploy models in briefing and campaign-planning pipeline.\",\n     \"MEDIUM\")\n\n# 10. Gold tier profile\n_gold_roi = df_feat.loc[df_feat[\"influencer_tier\"] == \"Gold Tier\", \"roi_ratio\"].mean()\n_add(\"GOLD_TIER_PROFILE\",\n     \"Gold Tier influencers deliver the highest mean ROI.\",\n     f\"Gold Tier mean ROI ratio: {_gold_roi:.2f}x.\",\n     \"Negotiate long-term preferred-partner contracts with Gold Tier cohort.\",\n     \"HIGH\")\n\n_out_path = CONFIG[\"REPORTS_DIR\"] + \"insights.json\"\nwith open(_out_path, \"w\", encoding=\"utf-8\") as fh:\n    json.dump(insights, fh, indent=2, ensure_ascii=False)\n\nfor _i in insights:\n    print(f\"[{_i['severity']:<6}] {_i['category']}: {_i['finding']}\")\n\nprint(f\"\\nInsights saved \u2192 {_out_path}\")\n"))

cells.append(_md_cell("## Phase 10 - Interactive Dashboard & Excel Export"))

cells.append(_code_cell("# -- Phase 10: Export -----------------------------------------------------\nimport plotly.graph_objects as go\nimport plotly.subplots as sp\n\nif \"df_feat\" not in dir():\n    df_feat = pd.read_csv(CONFIG[\"FEAT_CSV\"])\n\n# -- Plotly dashboard ------------------------------------------------------\n_fig = sp.make_subplots(\n    rows=2, cols=2,\n    subplot_titles=(\n        \"ROI Rate by Platform\",     \"Audience Quality by Tier\",\n        \"Campaign Cost vs Revenue\", \"Partnership Priority Distribution\",\n    ),\n)\n\n_p_roi = df_feat.groupby(\"platform_clean\")[\"target_numeric\"].mean().reset_index()\n_fig.add_trace(\n    go.Bar(x=_p_roi[\"platform_clean\"], y=_p_roi[\"target_numeric\"], name=\"ROI Rate\"),\n    row=1, col=1,\n)\n\n_fig.add_trace(\n    go.Box(x=df_feat[\"influencer_tier\"], y=df_feat[\"audience_quality_score\"],\n           name=\"Audience Quality\"),\n    row=1, col=2,\n)\n\n_fig.add_trace(\n    go.Scatter(\n        x=df_feat[CONFIG[\"COL_COST\"]], y=df_feat[CONFIG[\"COL_REVENUE\"]],\n        mode=\"markers\",\n        marker=dict(color=df_feat[\"target_numeric\"], colorscale=\"Viridis\",\n                    showscale=False, opacity=0.6),\n        name=\"Cost / Revenue\",\n    ),\n    row=2, col=1,\n)\n\n_prio_dist = df_feat[\"partnership_priority\"].value_counts().reset_index()\n_prio_dist.columns = [\"priority\", \"count\"]\n_fig.add_trace(\n    go.Bar(x=_prio_dist[\"priority\"], y=_prio_dist[\"count\"], name=\"Priority\"),\n    row=2, col=2,\n)\n\n_fig.update_layout(\n    title_text=\"Influencer Marketing ROI Intelligence Dashboard\",\n    height=700,\n    showlegend=False,\n)\n_dash_path = CONFIG[\"REPORTS_DIR\"] + \"interactive_dashboard.html\"\n_fig.write_html(_dash_path)\nprint(f\"Interactive dashboard saved \u2192 {_dash_path}\")\n\n# -- Excel export ----------------------------------------------------------\n_xlsx_path = CONFIG[\"REPORTS_DIR\"] + \"influencer_roi_export.xlsx\"\n\n_kpi_df = pd.DataFrame({\n    \"Metric\": [\n        \"Total Campaigns\", \"High-ROI Campaigns\", \"% High ROI\",\n        \"Mean ROI Ratio\", \"Median Campaign Cost ($)\",\n        \"Median Revenue ($)\", \"Total Revenue ($)\",\n    ],\n    \"Value\": [\n        len(df_feat),\n        int(df_feat[\"target_numeric\"].sum()),\n        round(df_feat[\"target_numeric\"].mean(), 4),\n        round(df_feat[\"roi_ratio\"].mean(), 4),\n        round(df_feat[CONFIG[\"COL_COST\"]].median(), 2),\n        round(df_feat[CONFIG[\"COL_REVENUE\"]].median(), 2),\n        round(df_feat[CONFIG[\"COL_REVENUE\"]].sum(), 2),\n    ],\n})\n\nwith pd.ExcelWriter(_xlsx_path, engine=\"openpyxl\") as _writer:\n    df_feat.to_excel(_writer, sheet_name=\"Full Campaign Dataset\", index=False)\n    _kpi_df.to_excel(_writer, sheet_name=\"KPI Summary\", index=False)\n    (df_feat.groupby(\"platform_clean\").mean(numeric_only=True)\n         .to_excel(_writer, sheet_name=\"Platform Analysis\"))\n    (df_feat.groupby(CONFIG[\"COL_NICHE\"]).mean(numeric_only=True)\n         .to_excel(_writer, sheet_name=\"Niche Analysis\"))\n    (df_feat.groupby(\"partnership_priority\")\n         .agg(count=(\"roi_ratio\", \"count\"), mean_roi=(\"roi_ratio\", \"mean\"))\n         .to_excel(_writer, sheet_name=\"Partnership Priority\"))\n    (df_feat[df_feat[\"influencer_tier\"] == \"Gold Tier\"]\n         .sort_values(\"roi_ratio\", ascending=False)\n         .to_excel(_writer, sheet_name=\"Gold Tier Influencers\", index=False))\n    (df_feat[df_feat[\"is_campaign_anomaly\"] == 1]\n         .to_excel(_writer, sheet_name=\"Anomalous Campaigns\", index=False))\n    (df_feat[df_feat[\"partnership_priority\"] == \"P1_STRATEGIC_PARTNER\"]\n         .to_excel(_writer, sheet_name=\"P1 Strategic Partners\", index=False))\n\nprint(f\"Excel workbook saved \u2192 {_xlsx_path}\")\n\n# -- Final summary ---------------------------------------------------------\nprint()\nprint(\"=\" * 60)\nprint(\"  INFLUENCER MARKETING ROI INTELLIGENCE - FINAL SUMMARY\")\nprint(\"=\" * 60)\nprint(f\"  Total campaigns analysed : {len(df_feat)}\")\nprint(f\"  High-ROI campaigns       : {int(df_feat['target_numeric'].sum())} ({df_feat['target_numeric'].mean():.1%})\")\nprint(f\"  Mean ROI ratio           : {df_feat['roi_ratio'].mean():.2f}x\")\n_best = _p_roi.sort_values(\"target_numeric\", ascending=False).iloc[0]\nprint(f\"  Best platform            : {_best['platform_clean']} ({_best['target_numeric']:.1%} high-ROI rate)\")\nprint(f\"  Gold Tier influencers    : {(df_feat['influencer_tier'] == 'Gold Tier').sum()}\")\nprint(f\"  P1 Strategic Partners    : {(df_feat['partnership_priority'] == 'P1_STRATEGIC_PARTNER').sum()}\")\nprint(f\"  Anomalous campaigns      : {df_feat['is_campaign_anomaly'].sum()}\")\nprint(\"=\" * 60)\n"))

