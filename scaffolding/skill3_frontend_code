cells.append(_code_cell("# -- Phase 11: Write export_for_frontend.py --\nimport textwrap as _tw\n\n_frontend_code = _tw.dedent('''\n    import json, os\n    import pandas as pd\n\n    def _load_data(config):\n        return pd.read_csv(config[\"FEAT_CSV\"])\n\n    def run_export():\n        from config.config import CONFIG\n        df      = _load_data(CONFIG)\n        out_dir = CONFIG[\"REPORTS_DIR\"] + \"frontend/\"\n        os.makedirs(out_dir, exist_ok=True)\n\n        kpis = {\n            \"total_campaigns\":          int(len(df)),\n            \"high_roi_count\":           int(df[\"target_numeric\"].sum()),\n            \"high_roi_rate\":            round(float(df[\"target_numeric\"].mean()), 4),\n            \"mean_roi_ratio\":           round(float(df[\"roi_ratio\"].mean()), 4),\n            \"median_campaign_cost_usd\": round(float(df[CONFIG[\"COL_COST\"]].median()), 2),\n            \"total_revenue_usd\":        round(float(df[CONFIG[\"COL_REVENUE\"]].sum()), 2),\n            \"mean_audience_quality\":    round(float(df[\"audience_quality_score\"].mean()), 4),\n            \"gold_tier_count\":          int((df[\"influencer_tier\"] == \"Gold Tier\").sum()),\n            \"p1_partner_count\":         int((df[\"partnership_priority\"] == \"P1_STRATEGIC_PARTNER\").sum()),\n            \"anomaly_count\":            int(df[\"is_campaign_anomaly\"].sum()),\n        }\n        with open(out_dir + \"kpis.json\", \"w\", encoding=\"utf-8\") as fh:\n            json.dump(kpis, fh, indent=2)\n\n        p_roi  = df.groupby(\"platform_clean\")[\"target_numeric\"].mean().reset_index()\n        charts = [{\n            \"id\":      \"platform_roi_rates\",\n            \"title\":   \"ROI Rates by Platform\",\n            \"type\":    \"bar\",\n            \"x_label\": \"Platform\",\n            \"y_label\": \"High-ROI Rate\",\n            \"data\":    [\n                {\"label\": str(r[\"platform_clean\"]), \"value\": round(float(r[\"target_numeric\"]), 4)}\n                for _, r in p_roi.iterrows()\n            ],\n        }]\n        with open(out_dir + \"charts.json\", \"w\", encoding=\"utf-8\") as fh:\n            json.dump(charts, fh, indent=2)\n\n        tiers = df.groupby(\"influencer_tier\").agg(\n            count=(CONFIG[\"COL_ID\"], \"count\"),\n            mean_roi=(\"roi_ratio\", \"mean\"),\n            mean_eng=(CONFIG[\"COL_ENGAGEMENT\"], \"mean\"),\n            mean_aqs=(\"audience_quality_score\", \"mean\"),\n            mean_cpu=(\"cost_per_discount_use\", \"mean\"),\n        ).reset_index()\n        tier_out = [{\n            \"tier\":                  str(r[\"influencer_tier\"]),\n            \"count\":                 int(r[\"count\"]),\n            \"mean_roi_ratio\":        round(float(r[\"mean_roi\"]), 4),\n            \"mean_engagement\":       round(float(r[\"mean_eng\"]), 4),\n            \"mean_audience_quality\": round(float(r[\"mean_aqs\"]), 4),\n            \"mean_cost_per_use\":     round(float(r[\"mean_cpu\"]), 4),\n        } for _, r in tiers.iterrows()]\n        with open(out_dir + \"influencer_tiers.json\", \"w\", encoding=\"utf-8\") as fh:\n            json.dump(tier_out, fh, indent=2)\n\n        p_perf = df.groupby(\"platform_clean\").agg(\n            campaign_count=(CONFIG[\"COL_ID\"], \"count\"),\n            high_roi_rate=(\"target_numeric\", \"mean\"),\n            mean_roi_ratio=(\"roi_ratio\", \"mean\"),\n            mean_cost_usd=(CONFIG[\"COL_COST\"], \"mean\"),\n            mean_revenue_usd=(CONFIG[\"COL_REVENUE\"], \"mean\"),\n        ).reset_index()\n        perf_out = [{\n            \"platform\":         str(r[\"platform_clean\"]),\n            \"campaign_count\":   int(r[\"campaign_count\"]),\n            \"high_roi_rate\":    round(float(r[\"high_roi_rate\"]), 4),\n            \"mean_roi_ratio\":   round(float(r[\"mean_roi_ratio\"]), 4),\n            \"mean_cost_usd\":    round(float(r[\"mean_cost_usd\"]), 2),\n            \"mean_revenue_usd\": round(float(r[\"mean_revenue_usd\"]), 2),\n        } for _, r in p_perf.iterrows()]\n        with open(out_dir + \"platform_performance.json\", \"w\", encoding=\"utf-8\") as fh:\n            json.dump(perf_out, fh, indent=2)\n\n        print(\"Frontend export complete.\")\n\n    if __name__ == \"__main__\":\n        run_export()\n''').lstrip('\\n')\n\nwith open(\"export_for_frontend.py\", \"w\", encoding=\"utf-8\") as _fh:\n    _fh.write(_frontend_code)\n\nprint(\"Created  ->  export_for_frontend.py\")\n"))

